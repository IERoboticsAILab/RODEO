# Copy to .env and adjust. All values are optional.
ROS_DOMAIN_ID=40              # must match every node that talks to this bridge
ROBOT_NAMESPACE=              # empty -> /dao/... ; panther -> /panther/dao/...
OWN_ASSIGNMENTS_ONLY=true     # publish task_assigned only for this wallet
ETH_WALLET_PASSPHRASE=        # keystore passphrase (empty for the dev keystore)
WALLET_PATH=~/.ros_eth/wallet.json
