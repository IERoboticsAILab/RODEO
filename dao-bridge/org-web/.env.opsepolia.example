# org-web on IE Coin, OP Sepolia (IERoboticsAILab/iecoin#1).
#   cp .env.opsepolia.example .env.opsepolia      # gitignored; put the operator key in it
#   docker compose --env-file .env.opsepolia up -d --force-recreate
# The operator (Organization owner) key is in Bitwarden: "RODEO Sepolia wallets + contracts".

RPC_URL=https://sepolia.optimism.io
ORGANIZATION_ADDRESS=0xA0121b301f86e54d0E9Df8A5BDFF506C5815d426
IECOIN_ADDRESS=0x0235a0145303B013561FD1E9658F8eD8BA5629Bd
ORGANIZATION_WALLET_PUBLIC=0xdB3E3A942dd824F228bA5151887Cc80C9B150146
ORGANIZATION_WALLET_PRIVATE=

# MetaMask: the same public RPC from every browser; no dev faucet on a public chain
WALLET_RPC_URL=https://sepolia.optimism.io
WALLET_CHAIN_NAME=OP Sepolia
DEV_FAUCET=0

# the contracts' first block (token holders scan, task timer)
IECOIN_DEPLOY_BLOCK=51608886
ORG_START_BLOCK=51608886

# Execution time limits, kept by org-web because these contracts have none on chain:
# each task gets its own deadline, from its own assignment
ORG_TASK_TIMEOUTS=Logistics=900
ORG_TIMER_EVERY_S=10

HOST_PORT=8080
NEXT_PUBLIC_API_BASE=/api
ABI_ROOT=contracts
ADDRESSES_JSON=addresses.json
CORS_ORIGINS=
