# Oracle on IE Coin, OP Sepolia (IERoboticsAILab/iecoin#1).
#   cp .env.opsepolia.example .env.opsepolia      # gitignored; put the oracle key in it
#   docker compose --env-file .env.opsepolia up -d --force-recreate
# The oracle key is in Bitwarden: "RODEO Sepolia wallets + contracts".

RPC_URL=https://optimism-sepolia-rpc.publicnode.com

ORGANIZATION_ADDRESS=0xA0121b301f86e54d0E9Df8A5BDFF506C5815d426
TASK_MANAGER_ADDRESS=0xddB7727600b2C3DD22737Bce371C6EdBC3184978
SERVICE_MANAGER_ADDRESS=0x0C3CCc95c02b4768706F0a2Bb53333E7d64587CA
IECOIN_ADDRESS=0x0235a0145303B013561FD1E9658F8eD8BA5629Bd

ORACLE_ADDRESS=0xE38432ea907059d785954F17458722618B84Ac4e
ORACLE_PRIVATE_KEY=

# events start at the contracts' first block; the public RPC allows 10,000 blocks per log query
START_BLOCK=51608886
LOG_CHUNK=10000

# OP Sepolia gas costs about 0.001 gwei; the Ganache floor (1 gwei) would spend
# the oracle's 0.005 ETH in about 25 verdicts
MIN_GAS_PRICE=1000000

# These contracts have no on-chain time limits: org-web keeps them (task_timer.py)
# and the oracle's expiry sweeper turns itself off.
CLOCK_CHECK=duration
CLOCK_TOLERANCE_SEC=5
LEGACY_PROOFS=1
EVENT_POLL_SEC=10   # fewer requests to the free public RPC
