# Oracle Environment Configuration
# Copy this file to .env and customize as needed
# After deploying new smart contracts, update the addresses below

# ==========================================
# BLOCKCHAIN CONNECTION
# ==========================================
RPC_URL=http://localhost:8545

# ==========================================
# SMART CONTRACT ADDRESSES
# Update these after each deployment!
# ==========================================
ORGANIZATION_ADDRESS=0xcEC91d876E8f003110D43381359b1bAd124e7F2b
TASK_MANAGER_ADDRESS=0xF818A7C2AFC45cF4B9DDC48933C9A1edD624e46f
SERVICE_MANAGER_ADDRESS=0x5370F78c6af2Da9cF6642382A3a75F9D5aEc9cc1
IECOIN_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016

# ==========================================
# WALLET CONFIGURATION
# Oracle wallet that validates and signs outcomes
# ==========================================
ORACLE_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
ORACLE_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# ==========================================
# FILE PATHS (usually don't need to change)
# ==========================================
ADDRESSES_JSON=/workspace/addresses.json
BASE_ABI=/workspace/abi
TASK_MANAGER_NAME=TaskManager

# Gas Settings
MIN_GAS_PRICE=1000000000
GAS_MULTIPLIER=1.2
# GAS_PRICE_OVERRIDE=2000000000

# Validation of RODEO proofs
CLOCK_TOLERANCE_SEC=5          # allowed clock difference between robot and chain
LEGACY_PROOFS=1                # 0: refuse legacy .bag/.csv proofs (they are not bound to a task)
DELIVERY_PLACE_RADIUS_M=1.0    # delivery: max distance from a place at arrival
DELIVERY_WEIGHT_TOL_KG=0.1     # delivery: tolerance on deck weight readings
DELIVERY_MIN_PACKAGE_KG=0.05   # delivery: smallest package that counts

# Waste-sorting validator (legacy ROS 1 bags)
POS_EPS=0.002
ARM_POS_EPS=0.005
ARM_TOTAL_DELTA_TOL=0.05
MIN_ARM_STATE_SEC=0.0
MIN_PATH_METERS=0.10

# Energy Calculation
IEC_PER_KWH=1.0
IEC_DECIMALS=18

